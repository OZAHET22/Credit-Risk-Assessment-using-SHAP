{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "Credit-Risk-Assesment-using-SHAP-main/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/predict",
      "dest": "api/index.py"
    },
    {
      "src": "/health",
      "dest": "api/index.py"
    },
    {
      "src": "/docs",
      "dest": "api/index.py"
    },
    {
      "src": "/redoc",
      "dest": "api/index.py"
    },
    {
      "src": "/openapi.json",
      "dest": "api/index.py"
    },
    {
      "src": "/style.css",
      "dest": "/Credit-Risk-Assesment-using-SHAP-main/static/style.css"
    },
    {
      "src": "/script.js",
      "dest": "/Credit-Risk-Assesment-using-SHAP-main/static/script.js"
    },
    {
      "src": "/static/(.*)",
      "dest": "/Credit-Risk-Assesment-using-SHAP-main/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}

